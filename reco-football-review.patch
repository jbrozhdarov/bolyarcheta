+/// Mirror the review project summary and timeline markers into Slint.
+fn sync_review_to_ui(state: &AppState, app: &RecoApp) {
+    let Some(project) = state.review_project.as_ref() else {
+        app.set_review_loaded(false);
+        app.set_review_project_path("".into());
+        app.set_review_keyframe_count(0);
+        app.set_review_attention_count(0);
+        app.set_review_keyframe_frames(slint::ModelRc::new(slint::VecModel::from(
+            Vec::<i32>::new(),
+        )));
+        app.set_review_attention_frames(slint::ModelRc::new(slint::VecModel::from(
+            Vec::<i32>::new(),
+        )));
+        return;
+    };
+
+    app.set_review_loaded(true);
+    app.set_review_project_path(
+        state
+            .review_project_path
+            .as_ref()
+            .map(|p| p.display().to_string())
+            .unwrap_or_default()
+            .into(),
+    );
+    app.set_review_keyframe_count(project.manual_keyframes.len() as i32);
+    app.set_review_attention_count(project.attention.len() as i32);
+    app.set_review_keyframe_frames(slint::ModelRc::new(slint::VecModel::from(
+        project
+            .manual_keyframes
+            .iter()
+            .map(|keyframe| keyframe.frame.min(i32::MAX as u64) as i32)
+            .collect::<Vec<_>>(),
+    )));
+    app.set_review_attention_frames(slint::ModelRc::new(slint::VecModel::from(
+        project
+            .attention
+            .iter()
+            .map(|range| range.start_frame.min(i32::MAX as u64) as i32)
+            .collect::<Vec<_>>(),
+    )));
+}
