+/// Prefer the FFmpeg executable bundled beside the GUI, then fall back to
+/// `PATH` for developer/source installs. Windows release archives ship a
+/// private `ffmpeg.exe`, so audio synchronization works without asking users
+/// to install another application globally.
+fn ffmpeg_program() -> std::path::PathBuf {
+    let executable_name = if cfg!(target_os = "windows") {
+        "ffmpeg.exe"
+    } else {
+        "ffmpeg"
+    };
+    if let Ok(current_exe) = std::env::current_exe()
+        && let Some(directory) = current_exe.parent()
+    {
+        let bundled = directory.join(executable_name);
+        if bundled.is_file() {
+            return bundled;
+        }
+    }
+    std::path::PathBuf::from(executable_name)
+}
