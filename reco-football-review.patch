+    fn apply_review_pose(&mut self) -> bool {
+        if !self.review_follow_enabled {
+            return false;
+        }
+        let frame = self.playback.frame_index();
+        let Some(pose) = self
+            .review_project
+            .as_ref()
+            .and_then(|project| project.corrected_pose_at(frame))
+        else {
+            return false;
+        };
+        let previous = self.pose.target_pose();
+        self.pose.set_target(pose);
+        (previous.yaw - pose.yaw).abs() > f32::EPSILON
+            || (previous.pitch - pose.pitch).abs() > f32::EPSILON
+            || (previous.fov_degrees.unwrap_or(FOV_DEFAULT)
+                - pose.fov_degrees.unwrap_or(FOV_DEFAULT))
+            .abs()
+                > f32::EPSILON
+    }
+
+    fn add_review_keyframe(&mut self) -> Result<(), String> {
+        let frame = self.playback.frame_index();
+        // The target is the exact view selected by the drag/zoom controls;
+        // `current_pose` may still be a few smoothing ticks behind it.
+        let pose = self.pose.target_pose();
+        let project = self
+            .review_project
+            .as_mut()
+            .ok_or("Run or load an AI review first")?;
+        project.add_keyframe(frame, pose);
+        self.review_follow_enabled = true;
+        self.save_review_project()
+    }
+
+    fn remove_review_keyframe(&mut self) -> Result<bool, String> {
+        let frame = self.playback.frame_index();
+        let project = self
+            .review_project
+            .as_mut()
+            .ok_or("Run or load an AI review first")?;
+        let removed = project.remove_nearest_keyframe(frame);
+        if removed {
+            self.save_review_project()?;
+        }
+        Ok(removed)
+    }
+
+    fn save_review_project(&self) -> Result<(), String> {
+        let project = self
+            .review_project
+            .as_ref()
+            .ok_or("No AI review project is loaded")?;
+        let path = self
+            .review_project_path
+            .as_ref()
+            .ok_or("Review project has no save path")?;
+        project.save(path).map_err(|e| e.to_string())
+    }
+
+    fn seek_to_review_frame(&mut self, frame: u64) -> Result<(), String> {
+        let total = self.playback.total_frames().unwrap_or(0).max(1);
+        let target = frame.min(total.saturating_sub(1));
+        self.playback
+            .seek(target as f32 / total as f32)
+            .map_err(|e| e.to_string())?;
+        self.review_follow_enabled = true;
+        if self.apply_review_pose() {
+            self.pose.tick_with(1.0);
+        }
+        self.preview_dirty = true;
+        Ok(())
+    }
+
