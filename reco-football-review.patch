@@ -0,0 +1,570 @@
+//! Reviewable AI camera trajectories.
+//!
+//! A review project is produced from the pipeline JSONL written by an AI
+//! analysis pass.  The GUI can then replay the complete camera move, add
+//! sparse manual keyframes, and export a dense CSV for `FilePanner` during
+//! the final render.  Manual edits are stored as deltas from the AI path, so
+//! improving one passage does not throw away useful detections elsewhere.
+
+use std::collections::BTreeMap;
+use std::fs::File;
+use std::io::{BufRead, BufReader, BufWriter, Write};
+use std::path::{Path, PathBuf};
+
+use anyhow::{Context, Result, bail};
+use reco_core::detect::director::ViewportPosition;
+use serde::{Deserialize, Serialize};
+
+const PROJECT_VERSION: u32 = 1;
+
+/// One AI-generated camera pose.
+#[derive(Debug, Clone, Copy, Serialize, Deserialize)]
+pub struct TrajectoryPoint {
+    pub frame: u64,
+    pub pose: ViewportPosition,
+    #[serde(default)]
+    pub ball_presence: f32,
+    #[serde(default)]
+    pub active_tracks: u32,
+    #[serde(default)]
+    pub detection_count: u32,
+}
+
+/// A camera pose explicitly approved or corrected by the user.
+#[derive(Debug, Clone, Copy, Serialize, Deserialize)]
+pub struct ManualKeyframe {
+    pub frame: u64,
+    pub pose: ViewportPosition,
+    /// Frames used to ease from/to the untouched AI trajectory when this is
+    /// the first or last manual keyframe in a passage.
+    pub blend_frames: u64,
+}
+
+/// A passage which deserves review because the tracker lost confidence.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct AttentionRange {
+    pub start_frame: u64,
+    pub end_frame: u64,
+    pub severity: f32,
+    pub reason: String,
+}
+
+/// Persistent review session stored next to the user's videos.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ReviewProject {
+    pub version: u32,
+    pub fps: f64,
+    pub total_frames: u64,
+    pub left_inputs: Vec<PathBuf>,
+    pub right_inputs: Vec<PathBuf>,
+    pub calibration_path: Option<PathBuf>,
+    pub preview_path: Option<PathBuf>,
+    pub trajectory: Vec<TrajectoryPoint>,
+    #[serde(default)]
+    pub manual_keyframes: Vec<ManualKeyframe>,
+    #[serde(default)]
+    pub attention: Vec<AttentionRange>,
+}
+
+#[derive(Debug, Clone, Copy, Default)]
+struct FrameStats {
+    ball_presence: f32,
+    active_tracks: u32,
+    detection_count: u32,
+}
+
+impl ReviewProject {
+    /// Build a review project from the pipeline event JSONL created during an
+    /// AI preview render.
+    #[allow(clippy::too_many_arguments)]
+    pub fn from_events(
+        events_path: &Path,
+        fps: f64,
+        total_frames: u64,
+        left_inputs: Vec<PathBuf>,
+        right_inputs: Vec<PathBuf>,
+        calibration_path: Option<PathBuf>,
+        preview_path: Option<PathBuf>,
+    ) -> Result<Self> {
+        if !fps.is_finite() || fps <= 0.0 {
+            bail!("review project requires a positive frame rate");
+        }
+
+        let file = File::open(events_path)
+            .with_context(|| format!("open AI events {}", events_path.display()))?;
+        let mut poses = BTreeMap::<u64, ViewportPosition>::new();
+        let mut stats = BTreeMap::<u64, FrameStats>::new();
+
+        for (line_number, line) in BufReader::new(file).lines().enumerate() {
+            let line = line.with_context(|| format!("read event line {}", line_number + 1))?;
+            if line.trim().is_empty() {
+                continue;
+            }
+            let value: serde_json::Value = serde_json::from_str(&line)
+                .with_context(|| format!("parse event line {}", line_number + 1))?;
+            let Some(kind) = value.get("kind").and_then(|v| v.as_str()) else {
+                continue;
+            };
+            let Some(frame) = value.get("frame_index").and_then(|v| v.as_u64()) else {
+                continue;
+            };
+
+            match kind {
+                "pose_presented" => {
+                    if let Some(pose) = value.get("pose") {
+                        let pose: ViewportPosition = serde_json::from_value(pose.clone())
+                            .with_context(|| {
+                                format!("parse presented pose on line {}", line_number + 1)
+                            })?;
+                        if valid_pose(pose) {
+                            poses.insert(frame, pose);
+                        }
+                    }
+                }
+                "panner_debug" => {
+                    let entry = stats.entry(frame).or_default();
+                    entry.ball_presence = value
+                        .get("ball_presence")
+                        .and_then(|v| v.as_f64())
+                        .unwrap_or(0.0) as f32;
+                }
+                "frame_complete" => {
+                    let entry = stats.entry(frame).or_default();
+                    entry.active_tracks = value
+                        .get("active_tracks")
+                        .and_then(|v| v.as_u64())
+                        .unwrap_or(0) as u32;
+                    entry.detection_count = value
+                        .get("detection_count")
+                        .and_then(|v| v.as_u64())
+                        .unwrap_or(0) as u32;
+                    let ball_present = value
+                        .get("ball_present")
+                        .and_then(|v| v.as_bool())
+                        .unwrap_or(false);
+                    if ball_present && entry.ball_presence == 0.0 {
+                        entry.ball_presence = 1.0;
+                    }
+                }
+                _ => {}
+            }
+        }
+
+        if poses.is_empty() {
+            bail!(
+                "AI analysis did not produce camera poses; check that AI tracking and event recording are enabled"
+            );
+        }
+
+        let trajectory: Vec<TrajectoryPoint> = poses
+            .into_iter()
+            .map(|(frame, pose)| {
+                let s = stats.get(&frame).copied().unwrap_or_default();
+                TrajectoryPoint {
+                    frame,
+                    pose,
+                    ball_presence: s.ball_presence.clamp(0.0, 1.0),
+                    active_tracks: s.active_tracks,
+                    detection_count: s.detection_count,
+                }
+            })
+            .collect();
+        let attention = build_attention_ranges(&trajectory, fps);
+
+        Ok(Self {
+            version: PROJECT_VERSION,
+            fps,
+            total_frames: total_frames.max(
+                trajectory
+                    .last()
+                    .map_or(0, |point| point.frame.saturating_add(1)),
+            ),
+            left_inputs,
+            right_inputs,
+            calibration_path,
+            preview_path,
+            trajectory,
+            manual_keyframes: Vec::new(),
+            attention,
+        })
+    }
+
+    pub fn load(path: &Path) -> Result<Self> {
+        let file =
+            File::open(path).with_context(|| format!("open review project {}", path.display()))?;
+        let mut project: Self = serde_json::from_reader(BufReader::new(file))
+            .with_context(|| format!("parse review project {}", path.display()))?;
+        if project.version != PROJECT_VERSION {
+            bail!(
+                "unsupported review project version {} (expected {})",
+                project.version,
+                PROJECT_VERSION
+            );
+        }
+        if project.trajectory.is_empty() {
+            bail!("review project contains no AI trajectory");
+        }
+        project.trajectory.sort_by_key(|point| point.frame);
+        project.manual_keyframes.sort_by_key(|point| point.frame);
+        Ok(project)
+    }
+
+    pub fn save(&self, path: &Path) -> Result<()> {
+        let file = File::create(path)
+            .with_context(|| format!("create review project {}", path.display()))?;
+        serde_json::to_writer_pretty(BufWriter::new(file), self)
+            .with_context(|| format!("write review project {}", path.display()))
+    }
+
+    /// Dense trajectory consumed by the existing production `FilePanner`.
+    pub fn save_corrected_csv(&self, path: &Path, start_frame: u64, end_frame: u64) -> Result<()> {
+        let file = File::create(path)
+            .with_context(|| format!("create corrected trajectory {}", path.display()))?;
+        let mut writer = BufWriter::new(file);
+        writeln!(writer, "frame,yaw,pitch,fov")?;
+        let end_frame = end_frame.min(self.total_frames).max(start_frame);
+        for source_frame in start_frame..end_frame {
+            let Some(pose) = self.corrected_pose_at(source_frame) else {
+                continue;
+            };
+            let frame = source_frame - start_frame;
+            writeln!(
+                writer,
+                "{frame},{:.9},{:.9},{:.4}",
+                pose.yaw,
+                pose.pitch,
+                pose.fov_degrees.unwrap_or(75.0)
+            )?;
+        }
+        writer.flush()?;
+        Ok(())
+    }
+
+    pub fn pose_at(&self, frame: u64) -> Option<ViewportPosition> {
+        interpolate_trajectory(&self.trajectory, frame)
+    }
+
+    /// AI trajectory with the user's sparse corrections blended in.
+    pub fn corrected_pose_at(&self, frame: u64) -> Option<ViewportPosition> {
+        let base = self.pose_at(frame)?;
+        if self.manual_keyframes.is_empty() {
+            return Some(base);
+        }
+
+        let index = self
+            .manual_keyframes
+            .partition_point(|keyframe| keyframe.frame <= frame);
+        let correction = match (index.checked_sub(1), self.manual_keyframes.get(index)) {
+            (Some(left_index), Some(right)) => {
+                let left = &self.manual_keyframes[left_index];
+                let left_delta = self.correction_for(left)?;
+                let right_delta = self.correction_for(right)?;
+                let span_frames = right.frame.saturating_sub(left.frame).max(1);
+                if span_frames <= left.blend_frames.saturating_add(right.blend_frames) {
+                    let t = (frame.saturating_sub(left.frame) as f32 / span_frames as f32)
+                        .clamp(0.0, 1.0);
+                    interpolate_delta(left_delta, right_delta, t)
+                } else {
+                    let left_distance = frame.saturating_sub(left.frame);
+                    let right_distance = right.frame.saturating_sub(frame);
+                    if left_distance < left.blend_frames {
+                        scale_delta(left_delta, fade_weight(left_distance, left.blend_frames))
+                    } else if right_distance < right.blend_frames {
+                        scale_delta(right_delta, fade_weight(right_distance, right.blend_frames))
+                    } else {
+                        PoseDelta::default()
+                    }
+                }
+            }
+            (Some(left_index), None) => {
+                let left = &self.manual_keyframes[left_index];
+                let delta = self.correction_for(left)?;
+                let distance = frame.saturating_sub(left.frame);
+                scale_delta(delta, fade_weight(distance, left.blend_frames))
+            }
+            (None, Some(right)) => {
+                let delta = self.correction_for(right)?;
+                let distance = right.frame.saturating_sub(frame);
+                scale_delta(delta, fade_weight(distance, right.blend_frames))
+            }
+            (None, None) => PoseDelta::default(),
+        };
+        Some(apply_delta(base, correction))
+    }
+
+    pub fn add_keyframe(&mut self, frame: u64, pose: ViewportPosition) {
+        if !valid_pose(pose) {
+            return;
+        }
+        let blend_frames = (self.fps * 1.5).round().max(1.0) as u64;
+        if let Some(existing) = self
+            .manual_keyframes
+            .iter_mut()
+            .find(|keyframe| keyframe.frame == frame)
+        {
+            existing.pose = pose;
+            existing.blend_frames = blend_frames;
+        } else {
+            self.manual_keyframes.push(ManualKeyframe {
+                frame,
+                pose,
+                blend_frames,
+            });
+            self.manual_keyframes.sort_by_key(|keyframe| keyframe.frame);
+        }
+    }
+
+    pub fn remove_nearest_keyframe(&mut self, frame: u64) -> bool {
+        let tolerance = (self.fps * 2.0).round().max(1.0) as u64;
+        let Some((index, distance)) = self
+            .manual_keyframes
+            .iter()
+            .enumerate()
+            .map(|(index, keyframe)| (index, keyframe.frame.abs_diff(frame)))
+            .min_by_key(|(_, distance)| *distance)
+        else {
+            return false;
+        };
+        if distance > tolerance {
+            return false;
+        }
+        self.manual_keyframes.remove(index);
+        true
+    }
+
+    pub fn next_attention_frame(&self, frame: u64) -> Option<u64> {
+        self.attention
+            .iter()
+            .find(|range| range.start_frame > frame)
+            .or_else(|| self.attention.first())
+            .map(|range| range.start_frame)
+    }
+
+    pub fn previous_attention_frame(&self, frame: u64) -> Option<u64> {
+        self.attention
+            .iter()
+            .rev()
+            .find(|range| range.start_frame < frame)
+            .or_else(|| self.attention.last())
+            .map(|range| range.start_frame)
+    }
+
+    fn correction_for(&self, keyframe: &ManualKeyframe) -> Option<PoseDelta> {
+        let base = self.pose_at(keyframe.frame)?;
+        Some(PoseDelta {
+            yaw: shortest_angle(keyframe.pose.yaw - base.yaw),
+            pitch: keyframe.pose.pitch - base.pitch,
+            fov: keyframe.pose.fov_degrees.unwrap_or(75.0) - base.fov_degrees.unwrap_or(75.0),
+        })
+    }
+}
+
+#[derive(Debug, Clone, Copy, Default)]
+struct PoseDelta {
+    yaw: f32,
+    pitch: f32,
+    fov: f32,
+}
+
+fn interpolate_trajectory(trajectory: &[TrajectoryPoint], frame: u64) -> Option<ViewportPosition> {
+    let index = trajectory.partition_point(|point| point.frame <= frame);
+    match (index.checked_sub(1), trajectory.get(index)) {
+        (Some(left_index), Some(right)) => {
+            let left = &trajectory[left_index];
+            if left.frame == frame {
+                return Some(left.pose);
+            }
+            let span = right.frame.saturating_sub(left.frame).max(1) as f32;
+            let t = (frame.saturating_sub(left.frame) as f32 / span).clamp(0.0, 1.0);
+            Some(interpolate_pose(left.pose, right.pose, t))
+        }
+        (Some(left_index), None) => Some(trajectory[left_index].pose),
+        (None, Some(right)) => Some(right.pose),
+        (None, None) => None,
+    }
+}
+
+fn interpolate_pose(left: ViewportPosition, right: ViewportPosition, t: f32) -> ViewportPosition {
+    ViewportPosition {
+        yaw: left.yaw + shortest_angle(right.yaw - left.yaw) * t,
+        pitch: left.pitch + (right.pitch - left.pitch) * t,
+        fov_degrees: Some(
+            left.fov_degrees.unwrap_or(75.0)
+                + (right.fov_degrees.unwrap_or(75.0) - left.fov_degrees.unwrap_or(75.0)) * t,
+        ),
+    }
+}
+
+fn interpolate_delta(left: PoseDelta, right: PoseDelta, t: f32) -> PoseDelta {
+    PoseDelta {
+        yaw: left.yaw + shortest_angle(right.yaw - left.yaw) * t,
+        pitch: left.pitch + (right.pitch - left.pitch) * t,
+        fov: left.fov + (right.fov - left.fov) * t,
+    }
+}
+
+fn scale_delta(delta: PoseDelta, weight: f32) -> PoseDelta {
+    PoseDelta {
+        yaw: delta.yaw * weight,
+        pitch: delta.pitch * weight,
+        fov: delta.fov * weight,
+    }
+}
+
+fn apply_delta(base: ViewportPosition, delta: PoseDelta) -> ViewportPosition {
+    ViewportPosition {
+        yaw: base.yaw + delta.yaw,
+        pitch: base.pitch + delta.pitch,
+        fov_degrees: Some((base.fov_degrees.unwrap_or(75.0) + delta.fov).clamp(10.0, 170.0)),
+    }
+}
+
+fn fade_weight(distance: u64, blend_frames: u64) -> f32 {
+    if distance >= blend_frames.max(1) {
+        0.0
+    } else {
+        1.0 - distance as f32 / blend_frames.max(1) as f32
+    }
+}
+
+fn shortest_angle(mut angle: f32) -> f32 {
+    while angle > std::f32::consts::PI {
+        angle -= std::f32::consts::TAU;
+    }
+    while angle < -std::f32::consts::PI {
+        angle += std::f32::consts::TAU;
+    }
+    angle
+}
+
+fn valid_pose(pose: ViewportPosition) -> bool {
+    pose.yaw.is_finite() && pose.pitch.is_finite() && pose.fov_degrees.is_none_or(f32::is_finite)
+}
+
+fn build_attention_ranges(trajectory: &[TrajectoryPoint], fps: f64) -> Vec<AttentionRange> {
+    let mut ranges = Vec::<AttentionRange>::new();
+    let join_gap = (fps * 0.75).round().max(1.0) as u64;
+    let minimum_length = (fps * 0.5).round().max(1.0) as u64;
+
+    for point in trajectory {
+        let (severity, reason) = if point.active_tracks == 0 && point.detection_count == 0 {
+            (1.0, "No tracked players or ball")
+        } else if point.ball_presence < 0.10 {
+            (0.72, "Ball tracking uncertain")
+        } else if point.ball_presence < 0.30 {
+            (0.55, "Low ball confidence")
+        } else {
+            continue;
+        };
+
+        if let Some(last) = ranges.last_mut()
+            && point.frame <= last.end_frame.saturating_add(join_gap)
+        {
+            last.end_frame = point.frame;
+            last.severity = last.severity.max(severity);
+            if severity >= 0.9 {
+                last.reason = reason.to_string();
+            }
+        } else {
+            ranges.push(AttentionRange {
+                start_frame: point.frame,
+                end_frame: point.frame,
+                severity,
+                reason: reason.to_string(),
+            });
+        }
+    }
+
+    ranges.retain(|range| {
+        range.severity >= 0.9 || range.end_frame.saturating_sub(range.start_frame) >= minimum_length
+    });
+    ranges
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn pose(yaw: f32, pitch: f32, fov: f32) -> ViewportPosition {
+        ViewportPosition {
+            yaw,
+            pitch,
+            fov_degrees: Some(fov),
+        }
+    }
+
+    fn project() -> ReviewProject {
+        ReviewProject {
+            version: PROJECT_VERSION,
+            fps: 30.0,
+            total_frames: 101,
+            left_inputs: Vec::new(),
+            right_inputs: Vec::new(),
+            calibration_path: None,
+            preview_path: None,
+            trajectory: vec![
+                TrajectoryPoint {
+                    frame: 0,
+                    pose: pose(0.0, 0.0, 60.0),
+                    ball_presence: 1.0,
+                    active_tracks: 4,
+                    detection_count: 5,
+                },
+                TrajectoryPoint {
+                    frame: 100,
+                    pose: pose(1.0, 0.2, 40.0),
+                    ball_presence: 1.0,
+                    active_tracks: 4,
+                    detection_count: 5,
+                },
+            ],
+            manual_keyframes: Vec::new(),
+            attention: Vec::new(),
+        }
+    }
+
+    #[test]
+    fn interpolates_ai_path() {
+        let p = project();
+        let middle = p.pose_at(50).unwrap();
+        assert!((middle.yaw - 0.5).abs() < 0.001);
+        assert!((middle.pitch - 0.1).abs() < 0.001);
+        assert!((middle.fov_degrees.unwrap() - 50.0).abs() < 0.001);
+    }
+
+    #[test]
+    fn manual_keyframes_override_without_destroying_base_path() {
+        let mut p = project();
+        p.add_keyframe(50, pose(0.8, -0.1, 45.0));
+        let corrected = p.corrected_pose_at(50).unwrap();
+        assert!((corrected.yaw - 0.8).abs() < 0.001);
+        assert!((corrected.pitch + 0.1).abs() < 0.001);
+        assert!((corrected.fov_degrees.unwrap() - 45.0).abs() < 0.001);
+        assert!((p.corrected_pose_at(0).unwrap().yaw - 0.0).abs() < 0.001);
+    }
+
+    #[test]
+    fn remove_nearest_respects_tolerance() {
+        let mut p = project();
+        p.add_keyframe(50, pose(0.8, 0.0, 50.0));
+        assert!(p.remove_nearest_keyframe(55));
+        assert!(p.manual_keyframes.is_empty());
+        assert!(!p.remove_nearest_keyframe(55));
+    }
+
+    #[test]
+    fn distant_keyframes_do_not_warp_the_match_between_them() {
+        let mut p = project();
+        p.fps = 10.0;
+        p.add_keyframe(10, pose(0.5, 0.0, 60.0));
+        p.add_keyframe(90, pose(1.4, 0.2, 40.0));
+
+        let untouched_middle = p.corrected_pose_at(50).unwrap();
+        let ai_middle = p.pose_at(50).unwrap();
+        assert!((untouched_middle.yaw - ai_middle.yaw).abs() < 0.001);
+        assert!((untouched_middle.pitch - ai_middle.pitch).abs() < 0.001);
+        assert!(
+            (untouched_middle.fov_degrees.unwrap() - ai_middle.fov_degrees.unwrap()).abs() < 0.001
+        );
+    }
+}
